// Nuurs ERP — Phase 1 data model.
// Every table carries companyId so a second trucking company can share the system later.
// Weights are integer kilograms. MNT amounts are integers. Foreign-currency rates are decimals.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DIRECTOR
  ACCOUNTANT
  MANAGER
  SITE_MANAGER
  DRIVER
}

enum Currency {
  MNT
  CNY
}

enum VehicleKind {
  TRACTOR
  TRAILER
}

enum VehicleStatus {
  ACTIVE
  IN_REPAIR
  IDLE
  SOLD
}

enum CounterpartyType {
  CLIENT
  CONSIGNOR
  BUYER
  FUEL_STATION
  INSURER
  WEIGHBRIDGE_OPERATOR
  REPAIR_VENDOR
}

enum LocationType {
  MINE
  STOCKPILE
  WEIGHBRIDGE
  CUSTOMS_YARD
  BORDER_PORT
  FUEL_STATION
  DEPOT
}

enum RateType {
  PER_TONNE
  PER_TONNE_KM
  PER_TRIP
}

enum WeightBasis {
  LOADED
  UNLOADED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum TripStatus {
  PLANNED
  LOADING
  IN_TRANSIT
  AT_BORDER
  UNLOADING
  COMPLETED
  CLOSED
}

enum TicketKind {
  LOAD
  UNLOAD
}

enum RecordStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocSource {
  WECHAT_BOT
  MANUAL_UPLOAD
  DRIVER_APP
  IMPORT
}

enum ExtractionStatus {
  QUEUED
  DONE
  FAILED
  NOT_A_DOCUMENT
}

enum PolicyType {
  DRIVER_LIABILITY
  VEHICLE
  CARGO
  OTHER
}

enum ExpenseCategory {
  ROAD_TOLL
  BORDER_FEE
  CUSTOMS_FEE
  PER_DIEM
  PARKING
  FINE
  OTHER
}

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  drivers        Driver[]
  vehicles       Vehicle[]
  rigs           Rig[]
  counterparties Counterparty[]
  locations      Location[]
  routes         Route[]
  contracts      Contract[]
  trips          Trip[]
  weighTickets   WeighTicket[]
  fuelEntries    FuelEntry[]
  tripExpenses   TripExpense[]
  files          StoredFile[]
  policies       InsurancePolicy[]
  changeLogs     ChangeLog[]
  exchangeRates  ExchangeRate[]
  fuelNorms      FuelNorm[]
  settings       Setting[]
  uploads        Upload[]
}

model User {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  name         String
  phone        String
  role         Role
  /// scrypt hash; drivers use a PIN, office staff a password — both stored the same way
  passwordHash String
  driverId     String?   @unique
  driver       Driver?   @relation(fields: [driverId], references: [id])
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  sessions     Session[]

  @@unique([companyId, phone])
}

model Session {
  id        String   @id @default(cuid())
  /// SHA-256 of the cookie token; the token itself is never stored
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Driver {
  id                String    @id @default(cuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])
  fullName          String
  registerNo        String?
  phone             String?
  wechatId          String?
  wechatDisplayName String?
  licenceNo         String?
  licenceClasses    String?
  licenceExpiry     DateTime?
  passportNo        String?
  passportExpiry    DateTime?
  hiredOn           DateTime?
  employmentStatus  String    @default("active")
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  user        User?
  rigs        Rig[]
  trips       Trip[]
  fuelEntries FuelEntry[]
}

model Vehicle {
  id               String        @id @default(cuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id])
  kind             VehicleKind
  /// Stored upper-case without spaces, e.g. 3341ӨМН
  plateNo          String
  vin              String?
  make             String?
  model            String?
  year             Int?
  axleCount        Int?
  tareKg           Int?
  fuelTankLitres   Int?
  gpsDeviceId      String?
  inspectionExpiry DateTime?
  cPermitNo        String?
  cPermitExpiry    DateTime?
  status           VehicleStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  rigsAsTractor  Rig[]             @relation("RigTractor")
  rigsAsTrailer1 Rig[]             @relation("RigTrailer1")
  rigsAsTrailer2 Rig[]             @relation("RigTrailer2")
  tripsTractor   Trip[]            @relation("TripTractor")
  tripsTrailer1  Trip[]            @relation("TripTrailer1")
  tripsTrailer2  Trip[]            @relation("TripTrailer2")
  fuelEntries    FuelEntry[]
  policies       InsurancePolicy[]

  @@unique([companyId, plateNo])
}

/// One tractor, two trailers and a driver for a period. A change closes the row and opens a new one.
model Rig {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  tractorId  String
  tractor    Vehicle   @relation("RigTractor", fields: [tractorId], references: [id])
  trailer1Id String?
  trailer1   Vehicle?  @relation("RigTrailer1", fields: [trailer1Id], references: [id])
  trailer2Id String?
  trailer2   Vehicle?  @relation("RigTrailer2", fields: [trailer2Id], references: [id])
  driverId   String?
  driver     Driver?   @relation(fields: [driverId], references: [id])
  validFrom  DateTime
  validTo    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Counterparty {
  id         String           @id @default(cuid())
  companyId  String
  company    Company          @relation(fields: [companyId], references: [id])
  name       String
  type       CounterpartyType
  registerNo String?
  contact    String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deletedAt  DateTime?

  contractsAsClient    Contract[]        @relation("ContractClient")
  contractsAsConsignor Contract[]        @relation("ContractConsignor")
  contractsAsBuyer     Contract[]        @relation("ContractBuyer")
  policies             InsurancePolicy[]
}

model Location {
  id              String       @id @default(cuid())
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id])
  name            String
  type            LocationType
  lat             Float?
  lng             Float?
  geofenceRadiusM Int?
  /// Default fuel price at a station, used when a receipt shows no price
  fuelPrice       Decimal?     @db.Decimal(12, 4)
  fuelCurrency    Currency?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  routesFrom  Route[]     @relation("RouteOrigin")
  routesTo    Route[]     @relation("RouteDestination")
  fuelEntries FuelEntry[]
}

model Route {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  name          String
  originId      String
  origin        Location  @relation("RouteOrigin", fields: [originId], references: [id])
  destinationId String
  destination   Location  @relation("RouteDestination", fields: [destinationId], references: [id])
  distanceKm    Int?
  borderPort    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  contracts Contract[]
  trips     Trip[]
}

model Contract {
  id                  String         @id @default(cuid())
  companyId           String
  company             Company        @relation(fields: [companyId], references: [id])
  contractNo          String
  /// Short name the office uses, usually the mine: Нагааранз, Цагаан залаат…
  name                String
  clientId            String?
  client              Counterparty?  @relation("ContractClient", fields: [clientId], references: [id])
  consignorId         String?
  consignor           Counterparty?  @relation("ContractConsignor", fields: [consignorId], references: [id])
  buyerId             String?
  buyer               Counterparty?  @relation("ContractBuyer", fields: [buyerId], references: [id])
  product             String?
  routeId             String?
  route               Route?         @relation(fields: [routeId], references: [id])
  rateType            RateType       @default(PER_TONNE)
  currency            Currency       @default(CNY)
  /// Whether the rate includes VAT (НӨАТ)
  vatIncluded         Boolean        @default(true)
  billableWeightBasis WeightBasis    @default(UNLOADED)
  startDate           DateTime?
  endDate             DateTime?
  status              ContractStatus @default(ACTIVE)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  rates ContractRate[]
  trips Trip[]

  @@unique([companyId, contractNo])
}

/// Contract rate over time. The rate in force on the trip's loading date applies.
model ContractRate {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])
  /// YYYY-MM-DD in Ulaanbaatar
  validFrom  String
  rate       Decimal  @db.Decimal(14, 4)
  createdAt  DateTime @default(now())

  @@unique([contractId, validFrom])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  currency  Currency
  validFrom String
  /// MNT per one unit of `currency`
  rateToMnt Decimal  @db.Decimal(14, 4)
  createdAt DateTime @default(now())

  @@unique([companyId, currency, validFrom])
}

/// Fuel norm per trip over time: 600 L until October, 650 L winter schedule from 2026-11-01.
model FuelNorm {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  validFrom     String
  litresPerTrip Int
  note          String?
  createdAt     DateTime @default(now())

  @@unique([companyId, validFrom])
}

model Setting {
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  key       String
  value     String

  @@id([companyId, key])
}

model Trip {
  id                String     @id @default(cuid())
  companyId         String
  company           Company    @relation(fields: [companyId], references: [id])
  tripNo            String
  contractId        String?
  contract          Contract?  @relation(fields: [contractId], references: [id])
  routeId           String?
  route             Route?     @relation(fields: [routeId], references: [id])
  driverId          String?
  driver            Driver?    @relation(fields: [driverId], references: [id])
  tractorId         String
  tractor           Vehicle    @relation("TripTractor", fields: [tractorId], references: [id])
  trailer1Id        String?
  trailer1          Vehicle?   @relation("TripTrailer1", fields: [trailer1Id], references: [id])
  trailer2Id        String?
  trailer2          Vehicle?   @relation("TripTrailer2", fields: [trailer2Id], references: [id])
  status            TripStatus @default(PLANNED)
  /// "auto" when a loading ticket arrived for a rig with no open trip
  createdBy         String
  startedAt         DateTime?
  loadedAt          DateTime?
  borderArrivedAt   DateTime?
  unloadedAt        DateTime?
  closedAt          DateTime?
  loadedNetKg       Int?
  unloadedNetKg     Int?
  // Cached results of the calculation module, refreshed whenever an approved record changes.
  revenueMnt        Int?
  revenueForeign    Decimal?   @db.Decimal(14, 2)
  revenueCurrency   Currency?
  rateApplied       Decimal?   @db.Decimal(14, 4)
  fuelCostMnt       Int        @default(0)
  fuelLitres        Int        @default(0)
  fuelCostEstimated Boolean    @default(false)
  driverPayMnt      Int        @default(0)
  otherCostMnt      Int        @default(0)
  marginMnt         Int?
  profitMnt         Int?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  weighTickets WeighTicket[]
  fuelEntries  FuelEntry[]
  expenses     TripExpense[]

  @@unique([companyId, tripNo])
  @@index([companyId, tractorId, status])
}

model StoredFile {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  storageKey String
  mimeType   String
  size       Int
  sha256     String
  uploadedBy String?
  source     DocSource
  createdAt  DateTime  @default(now())

  uploads           Upload[]
  ticketImages      WeighTicket[]
  fuelMeterImages   FuelEntry[]       @relation("FuelMeterImage")
  fuelReceiptImages FuelEntry[]       @relation("FuelReceiptImage")
  policyFiles       InsurancePolicy[]

  @@unique([companyId, sha256])
}

/// One received photo and what the vision step made of it. Kept even when extraction fails,
/// so nothing is lost and it can be reprocessed.
model Upload {
  id             String           @id @default(cuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id])
  fileId         String
  file           StoredFile       @relation(fields: [fileId], references: [id])
  source         DocSource
  uploadedById   String?
  /// Rig chosen by the uploader, if any (drivers upload for their own rig)
  tractorId      String?
  status         ExtractionStatus @default(QUEUED)
  classifiedAs   String?
  error          String?
  extractionJson Json?
  linkedTable    String?
  linkedId       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model WeighTicket {
  id                  String       @id @default(cuid())
  companyId           String
  company             Company      @relation(fields: [companyId], references: [id])
  tripId              String?
  trip                Trip?        @relation(fields: [tripId], references: [id])
  kind                TicketKind
  ticketNo            String?
  operatorName        String?
  consignorRaw        String?
  buyerRaw            String?
  carrierRaw          String?
  product             String?
  tractorPlate        String?
  trailerPlates       String[]
  driverName          String?
  driverRegisterNo    String?
  driverPhone         String?
  contractNoRaw       String?
  weightInKg          Int?
  weightOutKg         Int?
  netKg               Int?
  timeIn              DateTime?
  timeOut             DateTime?
  printedAt           DateTime?
  originRaw           String?
  destinationRaw      String?
  cPermit             String?
  sealNo              String?
  containerNo         String?
  weigherName         String?
  imageFileId         String?
  imageFile           StoredFile?  @relation(fields: [imageFileId], references: [id])
  source              DocSource
  extractionJson      Json?
  lowConfidenceFields String[]
  status              RecordStatus @default(PENDING)
  approvedById        String?
  approvedAt          DateTime?
  rejectReason        String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?

  @@unique([companyId, operatorName, ticketNo])
  @@index([companyId, status])
}

model FuelEntry {
  id                  String       @id @default(cuid())
  companyId           String
  company             Company      @relation(fields: [companyId], references: [id])
  tripId              String?
  trip                Trip?        @relation(fields: [tripId], references: [id])
  driverId            String?
  driver              Driver?      @relation(fields: [driverId], references: [id])
  tractorId           String?
  tractor             Vehicle?     @relation(fields: [tractorId], references: [id])
  /// Plate as printed or written, kept even when no vehicle matched
  plateRaw            String?
  stationId           String?
  station             Location?    @relation(fields: [stationId], references: [id])
  stationRaw          String?
  litres              Int
  unitPrice           Decimal?     @db.Decimal(12, 4)
  currency            Currency?
  amount              Decimal?     @db.Decimal(14, 2)
  filledAt            DateTime
  paymentMethod       String?
  meterImageFileId    String?
  meterImageFile      StoredFile?  @relation("FuelMeterImage", fields: [meterImageFileId], references: [id])
  receiptImageFileId  String?
  receiptImageFile    StoredFile?  @relation("FuelReceiptImage", fields: [receiptImageFileId], references: [id])
  source              DocSource
  extractionJson      Json?
  lowConfidenceFields String[]
  status              RecordStatus @default(PENDING)
  approvedById        String?
  approvedAt          DateTime?
  rejectReason        String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?

  @@index([companyId, status])
  @@index([companyId, tractorId, filledAt])
}

model TripExpense {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id])
  tripId    String
  trip      Trip            @relation(fields: [tripId], references: [id])
  category  ExpenseCategory
  amountMnt Int
  note      String?
  enteredBy String?
  status    RecordStatus    @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model InsurancePolicy {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  vehicleId       String
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id])
  insurerId       String?
  insurer         Counterparty? @relation(fields: [insurerId], references: [id])
  policyType      PolicyType
  policyNo        String?
  startDate       DateTime
  endDate         DateTime
  premiumMnt      Int?
  insuredValueMnt Int?
  contractFileId  String?
  contractFile    StoredFile?   @relation(fields: [contractFileId], references: [id])
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
}

/// Every change to an approved record: who, when, old and new value, why.
model ChangeLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  tableName String
  rowId     String
  field     String
  oldValue  String?
  newValue  String?
  userId    String
  reason    String
  changedAt DateTime @default(now())

  @@index([tableName, rowId])
}
