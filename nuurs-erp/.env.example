# PostgreSQL connection
DATABASE_URL="postgresql://nuurs:nuurs@localhost:5432/nuurs"

# Where uploaded photos and scans are stored (local disk). Object storage (R2/S3) comes later.
FILES_DIR="./storage"

# Vision extraction: "claude" for the real model, "mock" to run without an API key
# (the mock always returns the sample unloading ticket).
VISION_PROVIDER="mock"
ANTHROPIC_API_KEY=""
# Model name lives here, not in code. Check the Anthropic docs for current names.
VISION_MODEL="claude-opus-5-5"

# Session lifetime in days
SESSION_DAYS="14"
